<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.igirepay.lab3.ui.javafx.AdminController"
      prefWidth="1100" prefHeight="700"
      style="-fx-background-color: #f5f6fa;">

    <VBox prefWidth="240" prefHeight="700"
          style="-fx-background-color: #1a1f36; -fx-padding: 30 0 0 0;">

        <VBox alignment="CENTER" spacing="4" style="-fx-padding: 0 0 30 0;">
            <Label text="IgirePay" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #ffd700;"/>
            <Label text="Admin Panel" style="-fx-font-size: 11; -fx-text-fill: #8892b0;"/>
        </VBox>

        <VBox spacing="4" style="-fx-padding: 0 16 0 16;">
            <Button text="👥  Customers" onAction="#showCustomers"
                    prefWidth="208" prefHeight="44"
                    style="-fx-background-color: #ffd700; -fx-text-fill: #1a1f36;
                           -fx-font-weight: bold; -fx-background-radius: 8;
                           -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 16;"/>
            <Button text="💳  All Accounts" onAction="#showAccounts"
                    prefWidth="208" prefHeight="44"
                    style="-fx-background-color: transparent; -fx-text-fill: #8892b0;
                           -fx-background-radius: 8; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-cursor: hand;"/>
            <Button text="📋  All Transactions" onAction="#showTransactions"
                    prefWidth="208" prefHeight="44"
                    style="-fx-background-color: transparent; -fx-text-fill: #8892b0;
                           -fx-background-radius: 8; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-cursor: hand;"/>
            <Button text="📈  Reports" onAction="#showReports"
                    prefWidth="208" prefHeight="44"
                    style="-fx-background-color: transparent; -fx-text-fill: #8892b0;
                           -fx-background-radius: 8; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-cursor: hand;"/>
        </VBox>

        <VBox VBox.vgrow="ALWAYS"/>

        <VBox style="-fx-padding: 16;" spacing="8">
            <Label text="Olive Ntamakemwa"
                   style="-fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 13;"/>
            <Label text="Administrator"
                   style="-fx-text-fill: #ffd700; -fx-font-size: 11;"/>
            <Button text="🚪  Logout" onAction="#handleLogout"
                    prefWidth="208" prefHeight="36"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>
        </VBox>
    </VBox>

    <VBox HBox.hgrow="ALWAYS" style="-fx-padding: 30;" spacing="20">

        <HBox spacing="16">
            <VBox prefWidth="200" prefHeight="100" spacing="8"
                  style="-fx-background-color: #1a1f36; -fx-background-radius: 12; -fx-padding: 20;">
                <Label text="Total Customers" style="-fx-text-fill: #8892b0; -fx-font-size: 12;"/>
                <Label fx:id="totalCustomersLabel" text="0"
                       style="-fx-text-fill: #ffd700; -fx-font-size: 28; -fx-font-weight: bold;"/>
            </VBox>
            <VBox prefWidth="200" prefHeight="100" spacing="8"
                  style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-padding: 20;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                <Label text="Total Transactions" style="-fx-text-fill: #8892b0; -fx-font-size: 12;"/>
                <Label fx:id="totalTxLabel" text="0"
                       style="-fx-text-fill: #1a1f36; -fx-font-size: 28; -fx-font-weight: bold;"/>
            </VBox>
            <VBox prefWidth="200" prefHeight="100" spacing="8"
                  style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-padding: 20;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                <Label text="Failed Transactions" style="-fx-text-fill: #8892b0; -fx-font-size: 12;"/>
                <Label fx:id="failedTxLabel" text="0"
                       style="-fx-text-fill: #e74c3c; -fx-font-size: 28; -fx-font-weight: bold;"/>
            </VBox>
        </HBox>

        <VBox spacing="12" VBox.vgrow="ALWAYS"
              style="-fx-background-color: #ffffff; -fx-background-radius: 12;
                     -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Customers" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1a1f36;"/>
                <TextField fx:id="searchField" promptText="Search by name or phone..."
                           prefWidth="250" prefHeight="36"
                           style="-fx-background-radius: 8; -fx-border-radius: 8;
                                  -fx-border-color: #e0e0e0; -fx-padding: 8;"/>
                <Button text="Search" onAction="#handleSearch"
                        prefHeight="36" prefWidth="80"
                        style="-fx-background-color: #1a1f36; -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-cursor: hand;"/>
            </HBox>
            <TableView fx:id="customersTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idCol" text="ID" prefWidth="150"/>
                    <TableColumn fx:id="nameCol" text="Full Name" prefWidth="180"/>
                    <TableColumn fx:id="phoneCol" text="Phone" prefWidth="130"/>
                    <TableColumn fx:id="walletCol" text="Wallet Balance" prefWidth="130"/>
                    <TableColumn fx:id="statusCol" text="Status" prefWidth="100"/>
                    <TableColumn fx:id="actionCol" text="Action" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</HBox>
