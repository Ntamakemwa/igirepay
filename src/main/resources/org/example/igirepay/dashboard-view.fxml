<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.igirepay.lab3.ui.javafx.DashboardController"
      prefWidth="1100" prefHeight="700"
      style="-fx-background-color: #f5f6fa;">

    <VBox prefWidth="240" prefHeight="700"
          style="-fx-background-color: #1a1f36; -fx-padding: 30 0 0 0;">

        <VBox alignment="CENTER" spacing="4" style="-fx-padding: 0 0 30 0;">
            <Label text="IgirePay" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #ffd700;"/>
            <Label text="Digital Wallet" style="-fx-font-size: 11; -fx-text-fill: #8892b0;"/>
        </VBox>

        <VBox spacing="4" style="-fx-padding: 0 16 0 16;">
            <Button fx:id="dashboardBtn" text="📊  Dashboard" onAction="#showDashboard"
                    prefWidth="208" prefHeight="44" styleClass="sidebar-btn"
                    style="-fx-background-color: #ffd700; -fx-text-fill: #1a1f36;
                           -fx-font-weight: bold; -fx-background-radius: 8;
                           -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 16;"/>
            <Button text="💸  Transactions" onAction="#showTransactions"
                    prefWidth="208" prefHeight="44"
                    style="-fx-background-color: transparent; -fx-text-fill: #8892b0;
                           -fx-background-radius: 8; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-cursor: hand;"/>
            <Button text="🏦  MoKash" onAction="#showMoKash"
                    prefWidth="208" prefHeight="44"
                    style="-fx-background-color: transparent; -fx-text-fill: #8892b0;
                           -fx-background-radius: 8; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-cursor: hand;"/>
            <Button text="📈  Reports" onAction="#showReports"
                    prefWidth="208" prefHeight="44"
                    style="-fx-background-color: transparent; -fx-text-fill: #8892b0;
                           -fx-background-radius: 8; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-cursor: hand;"/>
            <Button text="⚙️  Settings" onAction="#showSettings"
                    prefWidth="208" prefHeight="44"
                    style="-fx-background-color: transparent; -fx-text-fill: #8892b0;
                           -fx-background-radius: 8; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-cursor: hand;"/>
        </VBox>

        <VBox VBox.vgrow="ALWAYS"/>

        <VBox style="-fx-padding: 16;" spacing="8">
            <Label fx:id="userNameLabel" text="User"
                   style="-fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 13;"/>
            <Label fx:id="userPhoneLabel" text=""
                   style="-fx-text-fill: #8892b0; -fx-font-size: 11;"/>
            <Button text="🚪  Logout" onAction="#handleLogout"
                    prefWidth="208" prefHeight="36"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>
        </VBox>
    </VBox>

    <VBox HBox.hgrow="ALWAYS" style="-fx-padding: 30;">

        <HBox spacing="16" style="-fx-padding: 0 0 24 0;">
            <VBox prefWidth="220" prefHeight="110" spacing="8"
                  style="-fx-background-color: #1a1f36; -fx-background-radius: 12; -fx-padding: 20;">
                <Label text="Wallet Balance" style="-fx-text-fill: #8892b0; -fx-font-size: 12;"/>
                <Label fx:id="walletBalanceLabel" text="0 RWF"
                       style="-fx-text-fill: #ffd700; -fx-font-size: 24; -fx-font-weight: bold;"/>
                <Label text="Available" style="-fx-text-fill: #8892b0; -fx-font-size: 11;"/>
            </VBox>

            <VBox prefWidth="220" prefHeight="110" spacing="8"
                  style="-fx-background-color: #ffffff; -fx-background-radius: 12;
                         -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                <Label text="MoKash Balance" style="-fx-text-fill: #8892b0; -fx-font-size: 12;"/>
                <Label fx:id="mokashBalanceLabel" text="N/A"
                       style="-fx-text-fill: #1a1f36; -fx-font-size: 24; -fx-font-weight: bold;"/>
                <Label text="Savings" style="-fx-text-fill: #8892b0; -fx-font-size: 11;"/>
            </VBox>

            <VBox prefWidth="220" prefHeight="110" spacing="8"
                  style="-fx-background-color: #ffffff; -fx-background-radius: 12;
                         -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                <Label text="Total Transactions" style="-fx-text-fill: #8892b0; -fx-font-size: 12;"/>
                <Label fx:id="totalTxLabel" text="0"
                       style="-fx-text-fill: #1a1f36; -fx-font-size: 24; -fx-font-weight: bold;"/>
                <Label text="All time" style="-fx-text-fill: #8892b0; -fx-font-size: 11;"/>
            </VBox>
        </HBox>

        <HBox spacing="12" style="-fx-padding: 0 0 24 0;">
            <Button text="+ Deposit" onAction="#handleDeposit"
                    prefHeight="44" prefWidth="140"
                    style="-fx-background-color: #2ecc71; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Button text="- Withdraw" onAction="#handleWithdraw"
                    prefHeight="44" prefWidth="140"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Button text="➤ Send Money" onAction="#handleSend"
                    prefHeight="44" prefWidth="140"
                    style="-fx-background-color: #3498db; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Button text=" International" onAction="#handleInternational"
                    prefHeight="44" prefWidth="140"
                    style="-fx-background-color: #9b59b6; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Button text="🚪  Logout" onAction="#handleLogout"
                    prefWidth="208" prefHeight="36"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;
               -fx-background-radius: 8; -fx-cursor: hand;"/>
        </HBox>

        <VBox spacing="12" style="-fx-background-color: #ffffff; -fx-background-radius: 12;
                                   -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
            <Label text="Recent Transactions"
                   style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1a1f36;"/>
            <TableView fx:id="transactionsTable" prefHeight="280">
                <columns>
                    <TableColumn fx:id="typeCol" text="Type" prefWidth="130"/>
                    <TableColumn fx:id="amountCol" text="Amount (RWF)" prefWidth="130"/>
                    <TableColumn fx:id="feeCol" text="Fee (RWF)" prefWidth="100"/>
                    <TableColumn fx:id="statusCol" text="Status" prefWidth="100"/>
                    <TableColumn fx:id="descCol" text="Description" prefWidth="200"/>
                    <TableColumn fx:id="dateCol" text="Date" prefWidth="180"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</HBox>
